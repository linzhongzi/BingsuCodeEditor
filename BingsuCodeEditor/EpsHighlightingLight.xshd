<?xml version="1.0"?>
<SyntaxDefinition name="EPS HighlightingLight" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
    <Color name="Comment" foreground="#0A5903" />
    <Color name="String" foreground="#F65108" />
    <Color name="LuaMacro" foreground="#A566FF" />
    <Color name="KeyWord" foreground="#1C59D7" />
    <Color name="CallFunction" foreground="#DD2D2D" />
    <Color name="VarType" foreground="#55BD21" />
    <Color name="Literal" foreground="#55BD21" />
    <Color name="Operator" foreground="#F15F5F" />
    <Color name="Highlight" foreground="#F15F5F" />
    <Color name="Object" foreground="#8E47F9" />
    <Color name="Function" foreground="#8E47F9" />
    <Color name="Array" foreground="#55BD21" />
    <Color name="Hex" foreground="#2DC494" />
    <Color name="Digit" foreground="#E6B739" />
	<!-- This is the main ruleset. -->
    <RuleSet>
    <!-- PHP 绿色系列 -->
    <Span color="LuaMacro" multiline="true" begin="&lt;\?" end="\?&gt;" />
    
    
    <Span color="Comment" begin="//" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />

    <!-- 函数调用 蓝色系列（系统色、语法等） -->
    <Keywords color="KeyWord">
        <Word>object</Word>
        <Word>static</Word>
        <Word>once</Word>
        <Word>if</Word>
        <Word>else</Word>
        <Word>for</Word>
        <Word>while</Word>
        <Word>function</Word>
        <Word>foreach</Word>
        <Word>return</Word>

        <Word>true</Word>
        <Word>True</Word>
        <Word>false</Word>
        <Word>False</Word>

        <Word>switch</Word>
        <Word>case</Word>
        <Word>break</Word>

		<Word>this</Word>
		<Word>continue</Word>
    </Keywords>


    <!-- 函数调用 红色系列 -->
    <Rule color="CallFunction">
        [\w\d]+(?=\()
    </Rule>


    <Span color="String" multiline="true">
        <Begin>"</Begin>
        <End>"</End>
        <RuleSet>
        <!-- nested span for escape sequences -->
        <Span begin="\\" end="." />
        </RuleSet>
    </Span>

    <Span color="String" multiline="true">
        <Begin>'</Begin>
        <End>'</End>
        <RuleSet>
        <!-- nested span for escape sequences -->
        <Span begin="\\" end="." />
        </RuleSet>
    </Span>

    <!-- 高亮色-->
    <Rule color="VarType">
	    :\s*[\w\d]+
    </Rule>
    <!-- 变量 + 关键字 绿色系列 -->
    <Keywords color="Literal">
	    <Word>selftype</Word>
        <Word>const</Word>
        <Word>var</Word>

        <Word>Enemy</Word>
        <Word>Ally</Word>
        <Word>AlliedVictory</Word>

        <Word>AtLeast</Word>
        <Word>AtMost</Word>
        <Word>Exactly</Word>

        <Word>SetTo</Word>
        <Word>Add</Word>
        <Word>Subtract</Word>

        <Word>Move</Word>
        <Word>Patrol</Word>
        <Word>Attack</Word>

        <Word>Enable</Word>
        <Word>Disable</Word>
        <Word>Toggle</Word>

        <Word>Ore</Word>
        <Word>Gas</Word>
        <Word>OreAndGas</Word>

        <Word>P1</Word>
        <Word>P2</Word>
        <Word>P3</Word>
        <Word>P4</Word>
        <Word>P5</Word>
        <Word>P6</Word>
        <Word>P7</Word>
        <Word>P8</Word>
        <Word>P9</Word>
        <Word>P10</Word>
        <Word>P11</Word>
        <Word>P12</Word>
        <Word>CurrentPlayer</Word>
        <Word>Foes</Word>
        <Word>Allies</Word>
        <Word>NeutralPlayers</Word>
        <Word>AllPlayers</Word>
        <Word>Force1</Word>
        <Word>Force2</Word>
        <Word>Force3</Word>
        <Word>Force4</Word>
        <Word>NonAlliedVictoryPlayers</Word>

        <Word>Set</Word>
        <Word>Clear</Word>
        <Word>Cleared</Word>
        <Word>Toggle</Word>
		<Word>Random</Word>
		
		<Word>//region</Word>
		<Word>//endregion</Word>
    </Keywords>

    <!-- 红色系 -->
    <Keywords color="Operator">
        <Word>import</Word>
        <Word>as</Word>
        <Word>+</Word>
        <Word>-</Word>
        <Word>=</Word>
        <Word>*</Word>
        <Word>/</Word>
    </Keywords>



	<!-- 高亮色 -->
	<Rule color="Highlight">
		​[\w\d]+
	</Rule>

    <!-- 对象定义 浅紫色 -->
    <Rule color="Object">
        (?&lt;=object)[\s]+[\w\d]+
    </Rule>
    <!-- 函数定义 淡紫色 -->
    <Rule color="Function">
        (?&lt;=function)[\s]+[\w\d]+
    </Rule>




    <!-- 数组 绿色系 -->
    <Rule color="Array">
        [\w\d]+(?=\[.*\])
    </Rule>



    <!-- 数字(Digits) 浅绿色-->
    <Rule color="Hex">
        \b0[xX][0-9a-fA-F]+  # hex number
    </Rule>

    <!-- 数字(Digits) 浅黄色 -->
    <Rule color="Digit">
        \b
        (    \d+(\.[0-9]+)?   #number with optional floating point
        |    \.[0-9]+         #or just starting with floating point
        )
        ([eE][+-]?[0-9]+)? # optional exponent
    </Rule>
    </RuleSet>
</SyntaxDefinition>